{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://192.168.14.77:3000/eidos/FRANK/spec/jui-events-v0.1.json",
  "title": "JUI event types on FRANK wire",
  "description": "JUI-specific events emitted through FRANK by JUIFRANKExt. Companion to frank-v0.1.json (generic envelope). Each definition specifies the expected component, transition, and state field schema for one JUI event kind.",
  "$comment": "All events use the frank-v0.1.json envelope: frank_v=1, event_type=STATE_TRANSITION, ts=ISO8601. This file constrains the JUI-specific component + transition + state combinations.",
  "definitions": {
    "jui.session.created": {
      "title": "Session created",
      "description": "Emitted when a new JUI session is registered in the session registry.",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "jui.session"
        },
        "event_type": {
          "type": "string",
          "const": "STATE_TRANSITION"
        },
        "transition": {
          "type": "string",
          "const": "created"
        },
        "state": {
          "type": "object",
          "required": ["session_id", "created_at"],
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Unique session identifier (UUID or similar opaque string)."
            },
            "created_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when the session was registered."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["component", "event_type", "transition", "state"]
    },

    "jui.session.closed": {
      "title": "Session closed",
      "description": "Emitted when a JUI session is torn down via close_session!().",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "jui.session"
        },
        "event_type": {
          "type": "string",
          "const": "STATE_TRANSITION"
        },
        "transition": {
          "type": "string",
          "const": "closed"
        },
        "state": {
          "type": "object",
          "required": ["session_id"],
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Unique session identifier of the session being closed."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["component", "event_type", "transition", "state"]
    },

    "jui.input.input_received": {
      "title": "Input received",
      "description": "Emitted when a client input event (key, mouse, resize) is dispatched to the server-side session.",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "jui.input"
        },
        "event_type": {
          "type": "string",
          "const": "STATE_TRANSITION"
        },
        "transition": {
          "type": "string",
          "const": "input_received"
        },
        "state": {
          "type": "object",
          "required": ["session_id", "event_type"],
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Session that received the input."
            },
            "event_type": {
              "type": "string",
              "description": "Julia type name of the input event (e.g. \"KeyEvent\", \"MouseEvent\", \"ResizeEvent\")."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["component", "event_type", "transition", "state"]
    },

    "jui.snapshot.snapshot_sent": {
      "title": "Snapshot sent",
      "description": "Emitted when a full Buffer snapshot is sent to a newly attached client.",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "jui.snapshot"
        },
        "event_type": {
          "type": "string",
          "const": "STATE_TRANSITION"
        },
        "transition": {
          "type": "string",
          "const": "snapshot_sent"
        },
        "state": {
          "type": "object",
          "required": ["session_id", "cell_count"],
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Session whose snapshot was sent."
            },
            "cell_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of cells in the snapshot (rows × cols)."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["component", "event_type", "transition", "state"]
    },

    "jui.diff.diff_emitted": {
      "title": "Diff emitted",
      "description": "Emitted when a cell-diff stream entry is sent to a connected client after a render cycle.",
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "jui.diff"
        },
        "event_type": {
          "type": "string",
          "const": "STATE_TRANSITION"
        },
        "transition": {
          "type": "string",
          "const": "diff_emitted"
        },
        "state": {
          "type": "object",
          "required": ["session_id", "cell_count"],
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Session that emitted the diff."
            },
            "cell_count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of changed cells in this diff batch."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["component", "event_type", "transition", "state"]
    }
  }
}
